              "pie": "Senegal"
            },
            {
              "url": "https://flagcdn.com/w160/ml.png",
              "pie": "Mali"
            }
          ],
          "preguntas": [
            {
              "tipo": "fill-the-gap",
              "oracion": "Los colores panafricanos se inspiraron en la bandera de ___.",
              "opciones": [
                "Egipto",
                "Ghana",
